# CO_ Network — copy to .env.local and fill in from the Supabase project
# (Dashboard -> Settings -> API). Anon key is public-safe; RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (API routes / batch jobs). NEVER expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
