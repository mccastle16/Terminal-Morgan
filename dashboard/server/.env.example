# ── LLM providers ────────────────────────────────────────────────────────────
# Keys are read from the repo-root .env first, then this server-local .env.
# Configure any subset; the AI Advisor picks the first one with a key and lets
# you switch between the configured providers in the UI.

# OpenAI / ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Perplexity — https://www.perplexity.ai/settings/api  (no chart/function calling)
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# Optional: server port (default: 3005)
# API_PORT=3005

# ── Authentication ────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to sign tokens if this is unset.
JWT_SECRET=

# Initial admin account, consumed once by `npm run seed-admin`.
# Password must be at least 8 characters. Change it after first login.
ADMIN_EMAIL=admin@cgcc.org
ADMIN_PASSWORD=Pass1234
# ADMIN_NAME=Administrator
# ADMIN_TITLE=System Admin
