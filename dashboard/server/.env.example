# ── LLM providers ────────────────────────────────────────────────────────────
# Keys are read from the repo-root .env first, then this server-local .env.
# Configure any subset; the AI Advisor picks the first one with a key and lets
# you switch between the configured providers in the UI.

# OpenAI / ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Perplexity — https://www.perplexity.ai/settings/api  (no chart/function calling)
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# Optional: server port (default: 3005)
# API_PORT=3005

# ── Authentication ────────────────────────────────────────────────────────────
# TODO: auth was backed by Neo4j (auth.js, seed-admin.js) — both deleted along
# with the rest of the Neo4j layer. Re-add JWT_SECRET / ADMIN_* here once the
# new database and its auth model exist.
