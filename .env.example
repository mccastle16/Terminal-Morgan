# Coral Gables BI Platform - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# GOOGLE CLOUD APIs
# =============================================================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# =============================================================================
# YELP API (Optional)
# =============================================================================
# Get from: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=your_yelp_api_key_here

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
#
# Option 1: Local (using Docker)
#   docker compose up -d
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coral_gables_bi
#
# Option 2: Cloud (using Neon - recommended for production)
#   Sign up at https://neon.tech (free tier available)
#   DATABASE_URL=postgresql://user:pass@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coral_gables_bi

# =============================================================================
# ANTHROPIC (for LLM validation)
# =============================================================================
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
