# Coral Gables OSINT — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Load before running any pipeline script:
#   export $(cat .env | xargs)

# ── Data collection APIs (Agent 1, Agent 8) ──────────────────────────────────
OUTSCRAPER_KEY=your_outscraper_key_here
APIFY_TOKEN=your_apify_token_here
SERPAPI_KEY=your_serpapi_key_here

# ── LLM (Agent 4, Agent 10, Agent 11) ────────────────────────────────────────
OPENAI_API_KEY=sk-...
AGENT4_MODEL=gpt-4o-mini     # or gpt-4o for higher quality
AGENT10_MODEL=gpt-4o-mini

# ── Neo4j (ETL loader + dashboard live API) ──────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cgcc2024graph

# Google Places API (not used by current agent pipeline)
# GOOGLE_PLACES_API_KEY=

# Yelp API (not used by current agent pipeline)
# YELP_API_KEY=

# Anthropic API (for future LLM-based validation)
# ANTHROPIC_API_KEY=

# =============================================================================
# CO_ NETWORK — Supabase (scripts/migrate_to_supabase.py + pipeline re-sink)
# =============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
