# Coral Gables OSINT — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then load before running the pipeline:
#   export $(cat .env | xargs)
#
# See howto.md for step-by-step key signup instructions.

# =============================================================================
# AGENT PIPELINE — API KEYS (see howto.md § 2 for signup links)
# =============================================================================

# Outscraper — Google Maps scraper (500 free requests/month)
# Sign up: https://outscraper.com → Profile → API Keys
OUTSCRAPER_KEY=your_outscraper_key_here

# Apify — Google Places actor ($5 free credit, one-time)
# Sign up: https://apify.com → Settings → Integrations
APIFY_TOKEN=your_apify_token_here

# SerpApi — Google Maps search API (100 free searches/month)
# Sign up: https://serpapi.com → Dashboard → API Key
SERPAPI_KEY=your_serpapi_key_here

# =============================================================================
# OPTIONAL — Legacy / future use
# =============================================================================

# Google Places API (not used by current agent pipeline)
# GOOGLE_PLACES_API_KEY=

# Yelp API (not used by current agent pipeline)
# YELP_API_KEY=

# Anthropic API (for future LLM-based validation)
# ANTHROPIC_API_KEY=

# PostgreSQL (for future database backend)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coral_gables_bi

# =============================================================================
# CO_ NETWORK — Supabase (scripts/migrate_to_supabase.py + pipeline re-sink)
# =============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
